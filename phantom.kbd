(defcfg
    process-unmapped-keys yes
    concurrent-tap-hold yes
)


(defsrc
    tab   w     l     y     p     k              z     x     o     u     ;     bspc
    caps  c     r     s     t     b              f     n     e     i     a     '
    lmet  j     v     d     g     q              m     h     /     ,     .     rmet
                      lctl  lalt  spc            rsft  ralt rctl
)

(defvar
    tap-timeout   100
    hold-timeout  200
    os-timeout    1500
    tt $tap-timeout
    ht $hold-timeout
    ost $os-timeout
)


(defalias

    oss   (one-shot $ost lsft)
    osc   (one-shot $ost lctl)
    osa   (one-shot $ost lalt)
    osg   (one-shot $ost lmet)
    hyp   (multi lctl lsft lalt lmet)
    cw    (caps-word $ost)
    chyp  (tap-hold-release $tt $ht @cw @hyp)
    ssft  (tap-hold-release $tt $ht spc lsft)

    ext   (layer-while-held extend)
    num   (layer-while-held number)
    sym   (layer-while-held symbol)
    gam   (layer-switch game)
    gam2   (layer-switch game2)
    can   (layer-switch canary)
    cat   (layer-while-held canary)

    ;; Symbols aliases
    { S-[           
    } S-]
    : S-;
    ! S-1
    @ S-2
    # S-3
    $ S-4
    % S-5
    ^ S-6
    & S-7
    * S-8
    ~ S-`
    < S-,   
    > S-.
    | S-\
    _ S--
    + S-=
    ? S-/
    crop C-S-M-t
    prts M-S-s
)

(deflayer canary
    tab   w     l     y     p     k              z     x     o     u     ;     bspc
    @chyp c     r     s     t     b              f     n     e     i     a     '
    lmet  j     v     d     g     q              m     h     /     ,     .     @ext
                      @osc  @ext  spc            @ssft @num  rctl
)

(deflayer number
    f1    f2    f3    f4    f5    f6             0     7     8     9     -     @+
    @hyp  @osc  @osa  @osg  @oss  XX             0     4     5     6     /     @*
    f7    f8    f9    f10   f11   f12            0     1     2     3     🔢．  enter
                      _     @sym  _              _     XX    .
)

(deflayer extend
    XX    XX    XX    @prts @crop lrld           pgup  home  up    end   XX    @gam
    @hyp  @osc  @osa  @osg  @oss  tab            pgdn  left  down  rght  XX    XX
    XX    C-z   C-x   C-c   C-v   C-a            XX    XX    XX    XX    XX    XX
                      _     XX    _              _     @sym  XX
)

(deflayer symbol
    XX     '     @<    @>    @:    @@            @~    S-'   @{    @}    @%    XX
    @hyp   @!    -     @+    =     `             @|    .     S-9   S-0   @?    XX 
    XX     @^    /     @*    @_    \             @&    @$    [     ]     @#    XX
                       XX    XX    _             _     XX    XX
)

(deflayer game
    tab   q     w     e     r     t              y     u     i     o     p     bspc
    lctl  a     s     d     f     g              h     j     k     l     ;     '
    lsft  z     x     c     v     b              n     m     ,     .     /     rsft
                      lalt  lalt  spc            spc    @cat  @can
)

(deflayer game2
    tab   q     w     e     r     t              y     u     i     o     p     [
    lctl  a     s     d     f     g              h     j     k     l     ;     '
    lsft  z     x     c     v     b              n     m     ,     .     /     rsft
                      lalt  lalt  spc            spc    @cat  @can
)

(defchordsv2
    (l y)    esc    55 all-released  ()
    (r s)    tab    55 all-released  ()
    (e i)    enter  55 all-released  ()
    (o u)    bspc   55 all-released  ()
    (n o)    del    55 all-released  ()
    (v d)    @cw    55 all-released  ()
)
