(defcfg
    process-unmapped-keys yes
    concurrent-tap-hold yes
)

(defsrc
    `     1     2     3     4     5     6     7     8     9     0     -     =
    tab   q     w     e     r     t     y     u     i     o     p     [     ]
    caps  a     s     d     f     g     h     j     k     l     ;     '     enter
    lsft  z     x     c     v     b     n     m     ,     .     /     rsft
    ;; lctl  lmet  lalt              spc               ralt  rctl
)   

(defvar
    tap-timeout   100
    hold-timeout  200
    tt $tap-timeout
    ht $hold-timeout
)


(defalias

    oss   (one-shot 2000 lsft)
    osc   (one-shot 2000 lctl)
    osa   (one-shot 2000 lalt)
    osg   (one-shot 2000 lmet)
    hyp   (multi lctl lsft lalt lmet)

    cw    (caps-word 2000)
    chyp  (tap-hold-release $tt $ht @cw @hyp)
    ssft  (tap-hold-release $tt $ht spc lsft)


    ext   (layer-while-held extend)
    num   (layer-while-held number)
    sym   (layer-while-held symbol)
    gam   (layer-switch game)
    can   (layer-switch canary)

    ;; Symbols aliases
    { S-[           
    } S-]
    : S-;
    ! S-1
    @ S-2
    # S-3
    $ S-4
    % S-5
    ^ S-6
    & S-7
    * S-8
    ~ S-`
    < S-,   
    > S-.
    | S-\
    _ S--
    + S-=
    ? S-/
)

(deflayer canary
    tab   w     l     y     p     k     XX    z     x     o     u     ;     bspc
    @chyp c     r     s     t     b     XX    f     n     e     i     a     '
    @osg  j     v     d     g     q     XX    m     h     /     ,     .     @ext
    XX    XX    XX    @osc  @ext  spc         @ssft @num  @osc  XX    XX    @gam
    ;; lctl  lmet  lalt              spc               ralt  rctl
)

(deflayer number
    XX    XX    XX    XX    XX    XX    XX    0     7     8     9     -     @+
    @hyp  @osc  @osa  @osg  @oss  XX    XX    0     4     5     6     /     @*
    XX    XX    XX    XX    XX    XX    XX    0     1     2     3     .     enter
    XX    XX    XX    @osc  @sym  _           0     XX    .     XX    XX    XX
    ;; lctl  lmet  lalt              spc               ralt  rctl
)

(deflayer extend
    XX    XX    XX    M-S-s prnt  XX    XX    pgup  home  up    end   XX    XX
    @hyp  @osc  @osa  @osg  @oss  tab   XX    pgdn  left  down  rght  XX    XX
    XX    C-z   C-x   C-c   C-v   C-a   XX    XX    XX    XX    XX    XX    XX
    XX    XX    XX    XX    XX    _           _     @sym  XX    XX    XX    XX
    ;; lctl  lmet  lalt              spc               ralt  rctl
)


(deflayer symbol
    XX     '     @<    @>    @:    @@   XX    @~    S-'   @{    @}    @%    XX
    XX     @!    -     @+    =     `    XX    @|    .     S-9   S-0   @?    XX 
    XX     @^    /     @*    @_    \    XX    @&    @$    [     ]     @#    XX
    XX    XX    XX     XX    XX    _          _     XX    XX    XX    XX    XX
    ;; lctl  lmet  lalt              spc               ralt  rctl
)

(deflayer game
    `     1     2     3     4     5     6     7     8     9     0     -     =
    tab   q     w     e     r     t     y     u     i     o     p     [     ]
    lctl  a     s     d     f     g     h     j     k     l     ;     '     enter
    lsft  z     x     c     v     b     n     m     ,     .     /     @can
    ;; lctl  lmet  lalt              spc               ralt  rctl
)

(defchordsv2 
    (2 3)    esc    35 all-released  ()
    (w e)    tab    35 all-released  ()
    (9 0)    bspc   35 all-released  ()
    (9 i)    del    35 all-released  ()
    (s d)    @cw    35 all-released  ()
    (o p)    enter  35 all-released  ()
)