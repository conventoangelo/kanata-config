(defcfg
    process-unmapped-keys yes
    concurrent-tap-hold yes
)

(defsrc
    tab   q     w     e     r     t     y     u     i     o     p     [
    caps  a     s     d     f     g     h     j     k     l     ;     '
    lsft  z     x     c     v     b     n     m     ,     .     /     rsft
                      lctl  lalt  bspc spc   ralt  rctl
)   

(defvar
    tap-timeout   100
    hold-timeout  200
    tt $tap-timeout
    ht $hold-timeout 
)


(defalias

    oss   (one-shot 2000 lsft)
    osc   (one-shot 2000 lctl)
    osa   (one-shot 2000 lalt)
    osg   (one-shot 2000 lmet)
    hyp   (multi lctl lsft lalt lmet)
    cw    (caps-word 2000)
    chyp  (tap-hold-release $tt $ht @cw @hyp)
    ssft  (tap-hold-release $tt $ht spc lsft)


    ext   (layer-while-held extend)
    num   (layer-while-held number)
    sym   (layer-while-held symbol)
    gam   (layer-switch game)
    can   (layer-switch canary)
    cat   (layer-while-held canary)
    qwe   (layer-while-held qwerty)

    ;; Symbols aliases
    { S-[           
    } S-]
    : S-;
    ! S-1
    @ S-2
    # S-3
    $ S-4
    % S-5
    ^ S-6
    & S-7
    * S-8
    ~ S-`
    < S-,   
    > S-.
    | S-\
    _ S--
    + S-=
    ? S-/
)

(deflayer canary
    tab   w     l     y     p     k     z     x     o     u     ;     bspc
    @chyp c     r     s     t     b     f     n     e     i     a     '
    lmet  j     v     d     g     q     m     h     /     ,     .     @ext
                      @osc  @ext  spc   @ssft @num  @osc
)

(deflayer number
    XX    XX    XX    XX    XX    XX    0     7     8     9     -     @+
    @hyp  @osc  @osa  @osg  @oss  XX    0     4     5     6     /     @*
    XX    XX    XX    XX    XX    XX    0     1     2     3     .     enter
                      @osc  @sym  _     _     XX    XX
)

(deflayer extend
    XX    XX    XX    M-S-s prnt  XX    pgup  home  up    end   XX    @gam
    @hyp  @osc  @osa  @osg  @oss  tab   pgdn  left  down  rght  XX    @qwe
    XX    C-z   C-x   C-c   C-v   C-a   XX    XX    XX    XX    XX    XX
                      XX    XX    _     _     @sym  XX
)


(deflayer symbol
    XX     '     @<    @>    @:    @@   @~    S-'   @{    @}    @%    XX
    XX     @!    -     @+    =     `    @|    .     S-9   S-0   @?    XX 
    XX     @^    /     @*    @_    \    @&    @$    [     ]     @#    XX
                       XX    XX    _    _     XX    XX
)

(deflayer qwerty
    tab   q     w     e     r     t     y     u     i     o     p     [
    lctl  a     s     d     f     g     h     j     k     l     ;     '
    lsft  z     x     c     v     b     n     m     ,     .     /     rsft
                      lalt  lmet  spc  spc    @cat  @can
)

(deflayer game
    tab   q     w     e     r     t     y     u     i     o     p     [
    lctl  a     s     d     f     g     h     j     k     l     ;     '
    lsft  z     x     c     v     b     n     m     ,     .     /     rsft
                      lalt  lalt  spc  spc    @cat  @can
)


(defchordsv2
    (w e)    esc    55 all-released  ()
    (s d)    tab    55 all-released  ()
    (i o)    bspc   55 all-released  ()
    (j i)    del    55 all-released  ()
    (x c)    @cw    55 all-released  ()
    (k l)    enter  55 all-released  ()
)